# 용연 정수장 API 환경변수 예시 — 복사해서 .env 로 만들고 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 로 커밋 제외됩니다. 자격증명을 소스/리포에 남기지 마세요.

# step_aiwtp DB (군집 실모델 연동에 사용). 미설정 시 API는 mock 폴백.
WTP_DB_HOST=
WTP_DB_PORT=44306
WTP_DB_USER=
WTP_DB_PASSWORD=
WTP_DB_NAME=step_aiwtp

# (선택) 서버
# SERVER_PORT=8002
# DEBUG=false
